{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aytim",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aytim-db",
      "migrations_dir": "migrations"
    }
  ]
}
